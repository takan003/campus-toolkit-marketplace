{
  "name": "campus-toolkit-marketplace",
  "version": "1.2.1",
  "private": true,
  "description": "校園工具箱功能模組市集：模組索引、發布包與市集網站。",
  "license": "MIT",
  "author": "takan003",
  "keywords": [
    "campus-toolkit",
    "module",
    "marketplace"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/takan003/campus-toolkit-marketplace.git"
  },
  "homepage": "https://github.com/takan003/campus-toolkit-marketplace#readme",
  "bugs": {
    "url": "https://github.com/takan003/campus-toolkit-marketplace/issues"
  },
  "scripts": {
    "publish": "node scripts/publish-module.mjs",
    "publish:push": "node scripts/publish-module.mjs --push",
    "publish:dry": "node scripts/publish-module.mjs --skip-commit",
    "publish:check": "node scripts/publish-module.mjs --dry-run",
    "submit": "node scripts/publish-module.mjs --skip-commit --status experimental",
    "validate": "node scripts/validate-marketplace-index.mjs",
    "check:docs": "node scripts/check-site-docs.cjs",
    "keys": "node scripts/manage-keys.mjs",
    "keys:validate": "node scripts/manage-keys.mjs validate",
    "keys:list": "node scripts/manage-keys.mjs list",
    "keys:add": "node scripts/manage-keys.mjs add",
    "keys:revoke": "node scripts/manage-keys.mjs revoke",
    "keys:rotate": "node scripts/manage-keys.mjs rotate",
    "keys:affected": "node scripts/manage-keys.mjs affected",
    "keys:export-trust": "node scripts/manage-keys.mjs export-trust",
    "test:keys": "node scripts/test-trusted-keys.mjs",
    "test:release-check": "node scripts/test-release-check.mjs"
  }
}
